# server/.env.example — 복사해서 .env 로 쓰세요 (.env 는 커밋하지 않습니다)

# 필수
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# 배포 시 채웁니다 (콤마 구분)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# 비우면 SQLite 로 떨어집니다.
#
# 로컬 (docker compose up db 로 띄운 뒤):
# DATABASE_URL=postgres://eden:eden-local-only@localhost:5432/eden
#
# RDS:
# DATABASE_URL=postgres://eden:PASSWORD@eden-db.xxxx.ap-northeast-2.rds.amazonaws.com:5432/eden
DATABASE_URL=

# ── 그래프 (Neo4j Aura) ────────────────────────────────────────
# 비우면 그래프 확장을 건너뛰고 벡터/키워드 검색만 씁니다.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── 임베딩 ─────────────────────────────────────────────────────
# 비우면 지금의 키워드 매칭(match_intent)으로 그대로 동작합니다.
# 벤치마크로 고른 모델 이름을 적습니다 (scripts/bench_embeddings.py 참조).
EMBEDDING_MODEL=text-embedding-3-small

# LLM (지금은 쓰지 않습니다. 연동 시 채웁니다)
OPENAI_API_KEY=
