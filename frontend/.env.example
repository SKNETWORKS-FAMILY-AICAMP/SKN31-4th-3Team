# frontend/.env.example — 복사해서 .env.local 로 쓰세요

# ★ 비워 두면 mock 데이터로 돕니다 (백엔드 없이 화면만 볼 때).
#   값이 있으면 그 주소의 Django 를 씁니다.
#
#   로컬 개발:  VITE_API_BASE_URL=http://localhost:8000
#   Compose:    VITE_API_BASE_URL=          (같은 도메인의 /api 로 감)
#   AWS:        VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
