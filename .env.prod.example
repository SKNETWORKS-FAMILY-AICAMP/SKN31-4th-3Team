# .env.prod.example — EC2 에서 .env.prod 로 복사해 채웁니다.
#
# ★ 이 파일은 예시입니다. 실제 값이 든 .env.prod 는 커밋하지 않습니다.
#   (.gitignore 의 .env.* 규칙에 걸립니다)
#
# ★ 값을 채팅이나 이슈에 붙이지 마세요.
#   EC2 에 SSH 로 들어가 직접 편집하는 것이 가장 안전합니다.

# ── Django ──────────────────────────────────────────────────────────
# 긴 임의 문자열. 만들려면:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# EC2 퍼블릭 IP 와 (있다면) 도메인. 콤마로 구분.
ALLOWED_HOSTS=127.0.0.1,localhost,YOUR_EC2_PUBLIC_IP

# ★ 프론트를 같은 EC2 의 nginx 가 서빙하면 CORS 가 필요 없습니다.
#   CloudFront 를 앞에 두는 경우에만 그 주소를 넣습니다.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# ── RDS ─────────────────────────────────────────────────────────────
# RDS 엔드포인트. 콘솔의 "엔드포인트" 값을 그대로 씁니다.
DATABASE_URL=postgres://eden:PASSWORD@eden-db.xxxx.ap-northeast-2.rds.amazonaws.com:5432/eden

# ── 임베딩 ──────────────────────────────────────────────────────────
# 호스트에 설치한 Ollama. 컨테이너에서 나가는 주소라 localhost 가 아닙니다.
OLLAMA_HOST=http://host.docker.internal:11434

# OpenAI 로 물러설 때만 채웁니다. 비어 있어도 앱은 돕니다.
OPENAI_API_KEY=

# ── Neo4j Aura ──────────────────────────────────────────────────────
# 비어 있으면 그래프 가중치가 꺼진 채로 돕니다 (검색은 벡터만으로 동작).
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
