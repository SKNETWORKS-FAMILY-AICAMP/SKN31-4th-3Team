# ── Python / Django ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.sqlite3
server/staticfiles/
server/media/

# ── 시크릿 — 절대 커밋하지 않는다 ───────────────────────────────
.env
.env.*
!.env.example

# ── Node / Vite ──────────────────────────────────────────────────
node_modules/
dist/
*.local

# ── 도구 ─────────────────────────────────────────────────────────
.DS_Store
.pytest_cache/
.vscode/
.idea/

# ── AI 보조 도구 설정 — 저장소에 남기지 않는다 ──────────────────
#
# 개인 작업 환경 설정이지 프로젝트의 일부가 아니다.
# 사람마다 쓰는 도구가 다르고, 커밋되면 그 사람의 설정이 팀 전체에
# 강요된다.
.claude/
.claude*
CLAUDE.md
.cursor/
.aider*
.github/copilot-instructions.md

# 임베딩 벤치마크가 만드는 것들 (다시 만들 수 있고, 크다)
server/.embed-cache/
server/bench*.json

# DB 덤프 — 150MB 가 넘어 GitHub 이 거부한다(100MB 제한).
# 로컬에서 만들어 scp 로 옮기는 물건이지 저장소에 남길 것이 아니다.
*.dump
*.sql.gz

# 배포 환경변수 예시는 .env.* 규칙에 걸려 있어서 따로 풀어 준다.
!.env.prod.example
